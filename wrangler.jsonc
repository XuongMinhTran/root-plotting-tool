// Cloudflare deployment: the pages in frontend/ as static assets, and the fitting
// API (Flask + CERN ROOT from backend/Dockerfile) as a Cloudflare Container.
// Deployed by Workers Builds on every push to main ("npx wrangler deploy"), or by
// hand with the same command. Containers need the Workers Paid plan.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "root-plotting-tool",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    // These paths go to the Worker (and on to the container); everything else is a file.
    "run_worker_first": ["/health", "/allowed", "/fit", "/histogram", "/simultaneous-fit"]
  },
  "containers": [
    {
      "class_name": "RootFitBackend",
      "image": "./backend/Dockerfile",
      "image_build_context": "./backend",
      // The ROOT image is several GB. standard-1 = 1/2 vCPU, 4 GiB memory, 8 GB disk.
      "instance_type": "standard-1",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "RootFitBackend" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RootFitBackend"] }],
  "observability": { "enabled": true }
}
