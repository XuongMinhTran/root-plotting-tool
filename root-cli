#!/bin/sh
# Operator launcher: credentials stay between the web server and ROOT service.
set -eu
cd "$(dirname "$0")"
docker build --platform linux/amd64 -t rootfit-backend backend
ROOT_CLI_TOKEN=$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')
export ROOT_CLI_TOKEN
cli_container=$(docker run -d --rm --init --platform linux/amd64 \
  --publish 127.0.0.1::8001 --read-only --tmpfs /tmp:rw,exec,nosuid,size=256m \
  --user 1000:1000 --cap-drop ALL --security-opt no-new-privileges \
  --memory 2g --cpus 2 --pids-limit 128 --env ROOT_CLI_TOKEN \
  rootfit-backend python3 native_app.py)
cleanup() { docker stop "$cli_container" >/dev/null 2>&1 || true; }
trap cleanup EXIT
trap 'exit 0' INT TERM
cli_address=$(docker port "$cli_container" 8001/tcp)
ROOT_NATIVE_URL="http://$cli_address"
export ROOT_NATIVE_URL
python3 - <<'PY'
import os, time, urllib.request
request = urllib.request.Request(os.environ['ROOT_NATIVE_URL'] + '/health',
    headers={'Authorization': 'Bearer ' + os.environ['ROOT_CLI_TOKEN']})
for attempt in range(30):
    try:
        with urllib.request.urlopen(request, timeout=1) as response:
            if response.status == 200:
                break
    except OSError:
        pass
    time.sleep(0.5)
else:
    raise SystemExit('The CLI backend did not start. Check Docker Desktop, then run ./root-cli again.')
PY
ROOT_WEB_OPEN=1
export ROOT_WEB_OPEN
python3 backend/web_gateway.py
